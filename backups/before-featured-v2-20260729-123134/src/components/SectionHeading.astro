---
interface Props {
  eyebrow: string;
  title: string;
  index?: string;
  description?: string;
}
const { eyebrow, title, index = "00", description } = Astro.props;
---

<header class="section-heading" data-reveal>
  <div class="section-kicker">
    <span>{index}</span>
    <span>{eyebrow}</span>
  </div>
  <h2>{title}</h2>
  {description && <p>{description}</p>}
</header>
