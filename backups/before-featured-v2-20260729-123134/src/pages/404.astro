---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404 — 信号丢失 — DENPA" description="没有找到这个页面。">
  <section class="not-found shell">
    <div>
      <p class="eyebrow">ERROR / 404</p>
      <h1>信号<br />丢失。</h1>
      <p>这个地址尚未进入档案，或者已经从旧版本中消失。</p>
      <a class="text-link" href="/">返回首页 ↗</a>
    </div>
    <div class="not-found__signal" aria-hidden="true">
      <span>404</span>
      <strong>NO SIGNAL</strong>
    </div>
  </section>
</BaseLayout>
