---
import BaseLayout from "@/layouts/BaseLayout.astro";
import artworks from "@/content/artworks.json";
---

<BaseLayout
  title="粗制滥造的绘画（我不是个好画家）— DENPA"
  description="Denpa的四幅绘画作品。"
>
  <section class="archive-hero archive-hero--artworks shell">
    <p class="eyebrow">02 / VISUAL ARCHIVE</p>
    <h1>粗制滥造的绘画<br />（我不是个好画家）</h1>
  </section>

  <section class="art-grid shell section" aria-label="画作列表">
    {artworks.map((artwork, index) => (
      <button
        class:list={["art-card", `art-card--${artwork.orientation}`]}
        type="button"
        data-artwork
        data-index={String(index)}
        aria-label={`查看第${index + 1}幅画作`}
      >
        <img
          src={artwork.src}
          alt={`画作 ${String(index + 1).padStart(2, "0")}`}
          width={artwork.width}
          height={artwork.height}
          loading={index < 2 ? "eager" : "lazy"}
          decoding="async"
        />
        <span class="art-card__number">{String(index + 1).padStart(2, "0")}</span>
      </button>
    ))}
  </section>

  <dialog class="art-dialog" data-art-dialog>
    <div class="art-dialog__bar">
      <span data-dialog-index>01 / 04</span>
      <button type="button" data-dialog-close aria-label="关闭大图">关闭 ×</button>
    </div>
    <div class="art-dialog__visual">
      <img
        data-dialog-image
        src={artworks[0].src}
        alt="画作 01"
        width={artworks[0].width}
        height={artworks[0].height}
      />
    </div>
    <div class="art-dialog__nav">
      <button type="button" data-dialog-prev>← 上一件</button>
      <button type="button" data-dialog-next>下一件 →</button>
    </div>
  </dialog>

  <script is:inline define:vars={{ artworks }}>
    const dialog = document.querySelector("[data-art-dialog]");
    const cards = Array.from(document.querySelectorAll("[data-artwork]"));
    let current = 0;

    const render = (index) => {
      if (!(dialog instanceof HTMLDialogElement)) return;
      current = (index + artworks.length) % artworks.length;
      const item = artworks[current];
      const image = dialog.querySelector("[data-dialog-image]");
      if (image instanceof HTMLImageElement) {
        image.src = item.src;
        image.width = item.width;
        image.height = item.height;
        image.alt = `画作 ${String(current + 1).padStart(2, "0")}`;
      }
      const counter = dialog.querySelector("[data-dialog-index]");
      if (counter) {
        counter.textContent = `${String(current + 1).padStart(2, "0")} / ${String(artworks.length).padStart(2, "0")}`;
      }
    };

    cards.forEach((card) => {
      card.addEventListener("click", () => {
        if (!(dialog instanceof HTMLDialogElement)) return;
        render(Number(card.dataset.index ?? 0));
        dialog.showModal();
      });
    });
    dialog?.querySelector("[data-dialog-close]")?.addEventListener("click", () => dialog.close());
    dialog?.querySelector("[data-dialog-prev]")?.addEventListener("click", () => render(current - 1));
    dialog?.querySelector("[data-dialog-next]")?.addEventListener("click", () => render(current + 1));
    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    window.addEventListener("keydown", (event) => {
      if (!(dialog instanceof HTMLDialogElement) || !dialog.open) return;
      if (event.key === "ArrowLeft") render(current - 1);
      if (event.key === "ArrowRight") render(current + 1);
    });
  </script>
</BaseLayout>
