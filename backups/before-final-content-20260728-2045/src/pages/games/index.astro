---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectVisual from "@/components/ProjectVisual.astro";
import games from "@/content/games.json";
---

<BaseLayout title="游戏与互动 — Denpa" description="Denpa 的游戏 Demo、玩法实验与互动原型。">
  <section class="archive-hero shell">
    <p class="eyebrow">04 / GAMES & INTERACTION</p>
    <h1>从想法到<br />可以亲手触碰的空间。</h1>
    <p>玩法实验、短篇叙事与可运行原型。每个项目都诚实标注当前阶段。</p>
  </section>

  <section class="game-index shell section">
    {games.map((game, index) => (
      <article class="game-row" data-reveal>
        <a class="game-row__visual" href={`/games/${game.slug}/`} aria-label={`查看 ${game.title}`}>
          <ProjectVisual
            variant={game.variant}
            title={game.englishTitle}
            number={game.number}
            ratio={index % 3 === 1 ? "portrait" : "wide"}
          />
        </a>
        <div class="game-row__content">
          <div class="game-row__meta">
            <span>{game.number}</span>
            <span>{game.year}</span>
            <span>{game.status}</span>
          </div>
          <h2><a href={`/games/${game.slug}/`}>{game.title}</a></h2>
          <p>{game.summary}</p>
          <ul aria-label="项目特点">
            {game.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
          <a class="text-link" href={`/games/${game.slug}/`}>进入项目 <span aria-hidden="true">↗</span></a>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
