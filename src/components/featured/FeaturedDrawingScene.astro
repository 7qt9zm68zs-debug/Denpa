<article
  class="featured-scene featured-scene--drawing"
  data-featured-scene="drawing"
  aria-label="人物画从草图到蓝色完稿的创作过程"
>
  <figure class="drawing-camera" data-drawing-camera>
    <div class="drawing-layer drawing-layer--sketch" data-drawing-layer="sketch">
      <img
        src="/media/artworks/featured-sketch.png"
        width="1672"
        height="941"
        alt="人物画极简头模草图"
        loading="eager"
        decoding="async"
      />
    </div>
    <div class="drawing-layer drawing-layer--draft" data-drawing-layer="draft">
      <img
        src="/media/artworks/featured-draft.png"
        width="1672"
        height="941"
        alt="人物画黑白完整线稿"
        loading="eager"
        decoding="async"
      />
      <span class="drawing-brush-edge" aria-hidden="true"></span>
    </div>
    <div class="drawing-layer drawing-layer--final" data-drawing-layer="final">
      <img
        src="/media/artworks/art-02.webp"
        width="1884"
        height="1079"
        alt="蓝色纸面上的人物完成稿"
        loading="eager"
        decoding="async"
      />
      <span class="drawing-brush-edge" aria-hidden="true"></span>
    </div>
    <figcaption class="sr-only">从构图草图、完整线稿到蓝色上色完稿。</figcaption>
  </figure>
</article>
