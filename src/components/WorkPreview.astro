---
interface Props {
  kind: "image" | "video" | "text";
  title: string;
  src?: string;
  width?: number;
  height?: number;
  paragraphs?: string[];
  loading?: "eager" | "lazy";
  autoplay?: boolean;
}

const {
  kind,
  title,
  src,
  width,
  height,
  paragraphs = [],
  loading = "lazy",
  autoplay = false
} = Astro.props;
---

<div class:list={["work-preview", `work-preview--${kind}`]}>
  {kind === "image" && src && (
    <img
      src={src}
      alt={title}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
    />
  )}

  {kind === "video" && src && (
    <video
      muted
      loop
      playsinline
      preload="metadata"
      data-lazy-video
      data-autoplay-preview={autoplay ? "true" : "false"}
      aria-label={`${title}预览`}
    >
      <source data-src={src} type="video/mp4" />
    </video>
  )}

  {kind === "text" && (
    <blockquote aria-label={`${title}节选`}>
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </blockquote>
  )}
</div>
