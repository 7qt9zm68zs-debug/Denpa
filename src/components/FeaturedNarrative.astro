---
import FeaturedNovelScene from "@/components/featured/FeaturedNovelScene.astro";
import FeaturedDrawingScene from "@/components/featured/FeaturedDrawingScene.astro";
import FeaturedFilmScene from "@/components/featured/FeaturedFilmScene.astro";
import FeaturedGameScene from "@/components/featured/FeaturedGameScene.astro";
import FeaturedIndex from "@/components/featured/FeaturedIndex.astro";
import "@/styles/featured-experience.scss";

const works = [
  {
    number: "01",
    title: "偷灵魂的人",
    type: "小说",
    href: "/fiction/soul-thief/"
  },
  {
    number: "02",
    title: "绘画",
    type: "绘画",
    href: "/artworks/"
  },
  {
    number: "03",
    title: "我和我的空壳",
    type: "影像",
    href: "/videos/"
  },
  {
    number: "04",
    title: "永不落幕",
    type: "游戏",
    href: "/games/endless/"
  }
];
---

<section
  class="featured-narrative featured-experience"
  id="featured"
  data-featured-experience
  data-grid-mode="dark"
  data-grid-strength="active"
>
  <div class="featured-stage" data-featured-stage>
    <header class="featured-stage__heading">
      <span>01</span>
      <span>SELECTED WORKS</span>
      <h2>节选作品</h2>
    </header>

    <div class="featured-world" data-featured-world>
      <FeaturedNovelScene />
      <FeaturedDrawingScene />
      <FeaturedFilmScene />
      <FeaturedGameScene />
    </div>

    <FeaturedIndex works={works} />

    <div class="featured-stage__progress" aria-hidden="true">
      <span data-featured-progress></span>
    </div>
  </div>
</section>

<script>
  import { initFeaturedExperience } from "@/utils/featured-experience";

  const root = document.querySelector<HTMLElement>("[data-featured-experience]");
  const cleanup = root ? initFeaturedExperience(root) : undefined;

  window.addEventListener("pagehide", () => cleanup?.(), { once: true });
  document.addEventListener("astro:before-swap", () => cleanup?.(), { once: true });
</script>
