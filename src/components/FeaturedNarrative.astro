---
import SectionHeading from "@/components/SectionHeading.astro";

const works = [
  {
    number: "01",
    title: "偷灵魂的人",
    type: "小说",
    href: "/fiction/soul-thief/"
  },
  {
    number: "02",
    title: "绘画",
    type: "绘画",
    href: "/artworks/"
  },
  {
    number: "03",
    title: "我和我的空壳",
    type: "影像",
    href: "/videos/"
  },
  {
    number: "04",
    title: "永不落幕",
    type: "游戏",
    href: "/games/endless/"
  }
];
---

<section
  class="featured-narrative section"
  id="featured"
  data-featured-narrative
  data-grid-mode="dark"
  data-grid-strength="active"
>
  <div class="shell featured-narrative__heading">
    <SectionHeading index="01" eyebrow="SELECTED WORKS" title="节选作品" />
  </div>

  <div class="featured-narrative__track" data-featured-track>
    <div class="featured-narrative__stage" data-featured-stage>
      <nav class="featured-index" aria-label="节选作品索引">
        <ol>
          {
            works.map((work, index) => (
              <li>
                <a
                  class:list={["featured-index__link", { "is-active": index === 0 }]}
                  href={work.href}
                  data-feature-index-link={index}
                  aria-current={index === 0 ? "true" : undefined}
                >
                  <span>{work.number}</span>
                  <strong>{work.title}</strong>
                  <em>{work.type}</em>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <a
        class="featured-mobile-index"
        href={works[0].href}
        data-feature-mobile-index
        aria-label={`打开${works[0].title}`}
      >
        <span data-feature-mobile-count>01 / 04</span>
        <strong data-feature-mobile-title>{works[0].title}</strong>
        <span aria-hidden="true">↗</span>
      </a>

      <div class="featured-narrative__canvas">
        <a
          class="featured-frame featured-frame--novel"
          href={works[0].href}
          data-feature-frame="0"
          data-mobile-feature="0"
          aria-label="阅读小说《偷灵魂的人》"
        >
          <p class="sr-only">
            雨水冲刷着我的头发，露出原本的乏味的黑色。我假笑的伪装终于被撕下。我不得不面对那个我一味逃避的事实——母亲死了、父亲死了，他们就埋在坟墓里，永远永远不会回来。我不停追随着那些幻影，却离他们越来越远。
          </p>
          <div class="featured-novel__meta" aria-hidden="true">
            <span>FICTION / 01</span>
            <span>偷灵魂的人</span>
          </div>
          <div class="featured-novel__scenes" aria-hidden="true">
            <div class="featured-novel__scene" data-novel-scene="0">
              <p>雨水冲刷着我的头发，露出原本的乏味的黑色。</p>
              <p>我假笑的伪装终于被撕下。</p>
            </div>
            <div class="featured-novel__scene" data-novel-scene="1">
              <p>我不得不面对那个我一味逃避的事实——</p>
              <p>母亲死了、父亲死了，他们就埋在坟墓里，永远永远不会回来。</p>
            </div>
            <div class="featured-novel__scene" data-novel-scene="2">
              <p>我不停追随着那些幻影，却离他们越来越远。</p>
            </div>
          </div>
        </a>

        <a
          class="featured-frame featured-frame--art"
          href={works[1].href}
          data-feature-frame="1"
          data-mobile-feature="1"
          aria-label="查看蓝色人物画"
        >
          <img
            src="/media/artworks/art-02.webp"
            width="1884"
            height="1079"
            alt="蓝色纸面上的人物近景线稿"
            loading="eager"
            decoding="async"
          />
        </a>

        <a
          class="featured-frame featured-frame--video"
          href={works[2].href}
          data-feature-frame="2"
          data-mobile-feature="2"
          aria-label="查看影像《我和我的空壳》"
        >
          <span class="featured-frame__paper" aria-hidden="true"></span>
          <img
            src="/media/videos/my-empty-shell/poster.webp"
            width="1023"
            height="579"
            alt="《我和我的空壳》黑白城市线稿首帧"
            loading="eager"
            decoding="async"
          />
        </a>

        <a
          class="featured-frame featured-frame--game"
          href={works[3].href}
          data-feature-frame="3"
          data-mobile-feature="3"
          aria-label="查看游戏《永不落幕》"
        >
          <img
            src="/media/games/endless/featured.webp"
            width="2493"
            height="1392"
            alt="花丛中的人物与“她做到了”字幕画面"
            loading="eager"
            decoding="async"
          />
        </a>

      </div>

      <div class="featured-narrative__progress" aria-hidden="true">
        <span data-feature-progress></span>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, motion } from "@/utils/motion";

  const root = document.querySelector<HTMLElement>("[data-featured-narrative]");

  if (root) {
    const works = [
      { number: "01", title: "偷灵魂的人", href: "/fiction/soul-thief/" },
      { number: "02", title: "绘画", href: "/artworks/" },
      { number: "03", title: "我和我的空壳", href: "/videos/" },
      { number: "04", title: "永不落幕", href: "/games/endless/" }
    ];
    const indexLinks = Array.from(root.querySelectorAll<HTMLAnchorElement>("[data-feature-index-link]"));
    const mobileIndex = root.querySelector<HTMLAnchorElement>("[data-feature-mobile-index]");
    const mobileCount = root.querySelector<HTMLElement>("[data-feature-mobile-count]");
    const mobileTitle = root.querySelector<HTMLElement>("[data-feature-mobile-title]");
    const progress = root.querySelector<HTMLElement>("[data-feature-progress]");
    let activeIndex = -1;

    const setActive = (index: number) => {
      const safeIndex = Math.max(0, Math.min(works.length - 1, index));
      if (safeIndex === activeIndex) return;
      activeIndex = safeIndex;

      indexLinks.forEach((link, linkIndex) => {
        const active = linkIndex === safeIndex;
        link.classList.toggle("is-active", active);
        if (active) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      });

      const work = works[safeIndex];
      if (mobileIndex) {
        mobileIndex.href = work.href;
        mobileIndex.setAttribute("aria-label", `打开${work.title}`);
      }
      if (mobileCount) mobileCount.textContent = `${work.number} / 04`;
      if (mobileTitle) mobileTitle.textContent = work.title;
      root.dataset.activeFeature = String(safeIndex);
    };

    setActive(0);

    const media = gsap.matchMedia();

    media.add(
      {
        animatedDesktop: "(min-width: 721px) and (prefers-reduced-motion: no-preference)",
        simplified: "(max-width: 720px), (prefers-reduced-motion: reduce)"
      },
      (context) => {
        const conditions = context.conditions as {
          animatedDesktop?: boolean;
          simplified?: boolean;
        };

        if (conditions.animatedDesktop) {
          const track = root.querySelector<HTMLElement>("[data-featured-track]");
          const novel = root.querySelector<HTMLElement>('[data-feature-frame="0"]');
          const art = root.querySelector<HTMLElement>('[data-feature-frame="1"]');
          const video = root.querySelector<HTMLElement>('[data-feature-frame="2"]');
          const game = root.querySelector<HTMLElement>('[data-feature-frame="3"]');
          const scenes = Array.from(root.querySelectorAll<HTMLElement>("[data-novel-scene]"));
          const artImage = art?.querySelector("img");
          const videoImage = video?.querySelector("img");
          const gameImage = game?.querySelector("img");
          const ambientGrid = document.querySelector<HTMLElement>("[data-ambient-grid]");

          if (
            !track ||
            !novel ||
            !art ||
            !video ||
            !game ||
            !artImage ||
            !videoImage ||
            !gameImage ||
            !ambientGrid ||
            scenes.length !== 3
          ) {
            return;
          }

          gsap.set(novel, { autoAlpha: 1 });
          gsap.set(scenes[0], {
            autoAlpha: 1,
            filter: "grayscale(.18) sepia(.08) hue-rotate(150deg) blur(12px)",
            scale: 1.035
          });
          gsap.set(scenes.slice(1), { autoAlpha: 0 });
          gsap.set([art, video, game], { autoAlpha: 0 });
          gsap.set(art, {
            clipPath: "inset(8% 94% 8% 0)",
            transformOrigin: "left center"
          });
          gsap.set(video, {
            clipPath: "inset(14% 43% 14% 43%)",
            transformOrigin: "center center"
          });
          gsap.set(game, {
            clipPath:
              "polygon(58% 65%, 61% 68%, 65% 68%, 63% 72%, 65% 76%, 60% 75%, 57% 79%, 54% 75%, 49% 76%, 52% 71%, 49% 68%, 54% 68%)"
          });
          gsap.set(artImage, {
            scale: 1.12,
            xPercent: 0,
            objectPosition: "0% 50%",
            transformOrigin: "left center"
          });
          gsap.set(videoImage, { autoAlpha: 0, scale: 1.08 });
          gsap.set(gameImage, { scale: 1.14, xPercent: 4, yPercent: 3 });
          gsap.set(ambientGrid, {
            "--grid-far-x": "0px",
            "--grid-far-y": "0px",
            "--grid-far-scale": 1,
            "--grid-far-rotate": "0deg",
            "--grid-mid-x": "0px",
            "--grid-mid-y": "0px",
            "--grid-mid-scale": 1,
            "--grid-mid-rotate": "0deg",
            "--grid-transition-boost": 0
          });

          const timeline = gsap.timeline({
            defaults: { ease: motion.easeStandard },
            scrollTrigger: {
              trigger: track,
              start: "top top",
              end: "bottom bottom",
              scrub: motion.scrub,
              invalidateOnRefresh: true,
              onUpdate: (self) => {
                const value = self.progress;
                const index = value < 0.34 ? 0 : value < 0.55 ? 1 : value < 0.76 ? 2 : 3;
                setActive(index);
                if (progress) progress.style.transform = `scaleX(${value})`;
              }
            }
          });

          timeline
            .to(
              scenes[0],
              {
                filter: "grayscale(.92) sepia(0) hue-rotate(0deg) blur(0px)",
                scale: 1,
                duration: 6
              },
              0
            )
            .to(
              ambientGrid,
              {
                "--grid-far-scale": 1.025,
                "--grid-far-y": "-8px",
                "--grid-mid-scale": 1.06,
                "--grid-mid-y": "12px",
                duration: 7
              },
              0
            )
            .to(scenes[0], { autoAlpha: 0, scale: 0.84, filter: "blur(1px)", duration: 4 }, 7)
            .fromTo(
              scenes[1],
              { autoAlpha: 0, scale: 0.78, filter: "brightness(.72) blur(2px)" },
              { autoAlpha: 1, scale: 1, filter: "brightness(1) blur(0px)", duration: 5 },
              10
            )
            .to(
              ambientGrid,
              {
                "--grid-far-scale": 0.98,
                "--grid-far-y": "9px",
                "--grid-mid-scale": 1.11,
                "--grid-mid-y": "-16px",
                duration: 7
              },
              10
            )
            .to(scenes[1], { autoAlpha: 0, scale: 0.8, filter: "brightness(.48) blur(2px)", duration: 4 }, 17)
            .fromTo(
              scenes[2],
              { autoAlpha: 0, scale: 0.82, filter: "blur(2px)" },
              { autoAlpha: 1, scale: 1, filter: "blur(0px)", duration: 4 },
              19
            )
            .to(
              scenes[2],
              {
                autoAlpha: 0.32,
                scale: 0.61,
                xPercent: 10,
                yPercent: -8,
                filter: "blur(2.5px)",
                duration: 7,
                ease: motion.easeExit
              },
              25
            )
            .to(
              ambientGrid,
              {
                "--grid-far-scale": 0.94,
                "--grid-far-x": "-18px",
                "--grid-far-y": "14px",
                "--grid-mid-scale": 1.18,
                "--grid-mid-x": "26px",
                "--grid-mid-y": "-22px",
                "--grid-mid-rotate": "2deg",
                "--grid-transition-boost": 1,
                duration: 8
              },
              24
            )
            .to(novel, { autoAlpha: 0, scale: 0.84, duration: 3 }, 31)
            .to(art, { autoAlpha: 1, duration: 0.6 }, 31)
            .to(
              art,
              {
                clipPath: "inset(5% 0% 5% 0%)",
                duration: 11,
                ease: motion.easeStandard
              },
              31
            )
            .to(
              artImage,
              {
                scale: 1,
                xPercent: 0,
                objectPosition: "50% 50%",
                duration: 12,
                ease: motion.easeStandard
              },
              31
            )
            .to(
              ambientGrid,
              {
                "--grid-far-scale": 1,
                "--grid-far-x": "0px",
                "--grid-far-y": "0px",
                "--grid-mid-scale": 1.03,
                "--grid-mid-x": "0px",
                "--grid-mid-y": "0px",
                "--grid-mid-rotate": "0deg",
                "--grid-transition-boost": 0.12,
                duration: 9
              },
              34
            )
            .to(
              art,
              {
                clipPath: "inset(18% 43% 18% 43%)",
                scale: 0.78,
                duration: 8,
                ease: motion.easeExit
              },
              47
            )
            .to(
              ambientGrid,
              {
                "--grid-far-scale": 0.97,
                "--grid-far-x": "12px",
                "--grid-mid-scale": 1.15,
                "--grid-mid-x": "-24px",
                "--grid-transition-boost": 0.9,
                duration: 8
              },
              47
            )
            .to(video, { autoAlpha: 1, duration: 0.5 }, 50)
            .to(
              video,
              {
                clipPath: "inset(10% 31% 10% 31%)",
                duration: 5,
                ease: motion.easeEnter
              },
              50
            )
            .to(art, { autoAlpha: 0, duration: 3 }, 52)
            .to(
              video,
              {
                clipPath: "inset(5% 6% 5% 6%)",
                duration: 9,
                ease: motion.easeStandard
              },
              55
            )
            .to(videoImage, { autoAlpha: 1, scale: 1, duration: 7 }, 56)
            .to(
              ambientGrid,
              {
                "--grid-far-scale": 1,
                "--grid-far-x": "0px",
                "--grid-mid-scale": 1.02,
                "--grid-mid-x": "0px",
                "--grid-transition-boost": 0.1,
                duration: 9
              },
              55
            )
            .to(video, { filter: "brightness(.62)", duration: 5 }, 69)
            .to(game, { autoAlpha: 1, duration: 0.4 }, 69)
            .to(
              game,
              {
                clipPath:
                  "polygon(-5% -5%, 50% -5%, 105% -5%, 105% 25%, 105% 50%, 105% 105%, 50% 105%, -5% 105%, -5% 75%, -5% 50%, -5% 25%, -5% -5%)",
                duration: 10,
                ease: motion.easeStandard
              },
              69
            )
            .to(video, { autoAlpha: 0, scale: 0.9, duration: 5 }, 73)
            .to(
              ambientGrid,
              {
                "--grid-far-scale": 0.96,
                "--grid-far-y": "14px",
                "--grid-mid-scale": 1.12,
                "--grid-mid-y": "-18px",
                "--grid-transition-boost": 0.74,
                duration: 9
              },
              69
            )
            .to(
              gameImage,
              {
                scale: 1,
                xPercent: 0,
                yPercent: 0,
                duration: 14,
                ease: motion.easeStandard
              },
              76
            )
            .to(
              ambientGrid,
              {
                "--grid-far-scale": 1,
                "--grid-far-y": "0px",
                "--grid-mid-scale": 1,
                "--grid-mid-y": "0px",
                "--grid-transition-boost": 0,
                duration: 10
              },
              80
            )
            .to(
              game,
              {
                scale: 0.84,
                autoAlpha: 0.48,
                duration: 8,
                ease: motion.easeExit
              },
              94
            )
            .to(
              ambientGrid,
              {
                "--grid-far-scale": 0.92,
                "--grid-mid-scale": 1.17,
                "--grid-mid-rotate": "2deg",
                "--grid-transition-boost": 1,
                duration: 8
              },
              94
            );

          const refresh = () => ScrollTrigger.refresh();
          const timer = window.setTimeout(refresh, 80);
          const resizeObserver = new ResizeObserver(() => refresh());
          resizeObserver.observe(root);
          root.querySelectorAll("img").forEach((image) => {
            if (!image.complete) image.addEventListener("load", refresh, { once: true });
          });

          return () => {
            window.clearTimeout(timer);
            resizeObserver.disconnect();
            timeline.scrollTrigger?.kill();
            timeline.kill();
          };
        }

        const mobileSections = Array.from(root.querySelectorAll<HTMLElement>("[data-mobile-feature]"));
        const rootObserver = new IntersectionObserver(
          ([entry]) => {
            root.classList.toggle("is-mobile-active", Boolean(entry?.isIntersecting));
          },
          { threshold: 0.01 }
        );
        const mobileTrack = root.querySelector<HTMLElement>("[data-featured-track]");
        if (mobileTrack) rootObserver.observe(mobileTrack);
        const observer = new IntersectionObserver(
          (entries) => {
            const active = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
            if (!active) return;
            setActive(Number((active.target as HTMLElement).dataset.mobileFeature ?? 0));
          },
          { rootMargin: "-30% 0px -42% 0px", threshold: [0, 0.2, 0.5, 0.8] }
        );
        mobileSections.forEach((section) => observer.observe(section));
        if (progress) progress.style.transform = "scaleX(1)";

        return () => {
          observer.disconnect();
          rootObserver.disconnect();
          root.classList.remove("is-mobile-active");
        };
      }
    );
  }
</script>

<style lang="scss">
  .featured-narrative {
    --stage-inline: min(78vw, 1320px);
    background: rgba(17, 17, 17, 0.82);
    color: var(--white);
    overflow: clip;
    position: relative;
    z-index: 2;
  }

  .featured-narrative__heading {
    padding-bottom: clamp(2rem, 4vw, 4rem);
  }

  .featured-narrative__track {
    min-height: 485svh;
    position: relative;
  }

  .featured-narrative__stage {
    align-items: center;
    display: grid;
    height: 100svh;
    isolation: isolate;
    overflow: clip;
    position: sticky;
    top: 0;
    z-index: 2;
  }

  .featured-narrative__canvas {
    height: min(76svh, 820px);
    justify-self: end;
    margin-right: clamp(2rem, 4vw, 5.5rem);
    position: relative;
    width: var(--stage-inline);
  }

  .featured-frame {
    color: inherit;
    display: grid;
    inset: 0;
    overflow: hidden;
    position: absolute;
    text-decoration: none;
    transform-origin: center;
    z-index: 3;
  }

  .featured-frame:focus-visible {
    outline: 2px solid var(--lime);
    outline-offset: 8px;
  }

  .featured-frame--novel {
    align-content: center;
    background:
      linear-gradient(90deg, rgba(17, 17, 17, 0.25), rgba(17, 17, 17, 0)),
      transparent;
    padding: clamp(2rem, 6vw, 7rem);
    z-index: 4;
  }

  .featured-novel__meta {
    display: flex;
    font-family: var(--sans);
    font-size: 0.7rem;
    justify-content: space-between;
    letter-spacing: 0.14em;
    position: absolute;
    text-transform: uppercase;
    top: 0;
    width: 100%;
    z-index: 4;
  }

  .featured-novel__scenes {
    align-items: center;
    display: grid;
    min-height: 56svh;
    position: relative;
  }

  .featured-novel__scene {
    grid-area: 1 / 1;
    max-width: min(58rem, 70vw);
    position: relative;
    transform-origin: center;
    width: 100%;
  }

  .featured-novel__scene p {
    font-family: var(--serif);
    font-size: clamp(1.7rem, 3.35vw, 4.7rem);
    line-height: 1.36;
    margin: 0;
    text-wrap: pretty;
  }

  .featured-novel__scene p + p {
    margin-top: 0.8em;
  }

  .featured-novel__scene[data-novel-scene="2"] p {
    font-size: clamp(1.55rem, 3vw, 4.1rem);
    white-space: nowrap;
  }

  .featured-frame--art,
  .featured-frame--video,
  .featured-frame--game {
    align-items: center;
    justify-items: center;
  }

  .featured-frame--art {
    background: #7a98c9;
  }

  .featured-frame--video {
    background: var(--paper);
  }

  .featured-frame--game {
    background: #eee3d2;
  }

  .featured-frame--art img,
  .featured-frame--video img,
  .featured-frame--game img {
    display: block;
    height: 100%;
    object-fit: contain;
    position: relative;
    width: 100%;
    will-change: transform;
  }

  .featured-frame--art img {
    object-fit: cover;
    object-position: left center;
  }

  .featured-frame--video img {
    object-fit: cover;
  }

  .featured-frame--game img {
    object-fit: contain;
  }

  .featured-frame__paper {
    background: var(--paper);
    inset: 0;
    position: absolute;
  }

  .featured-index {
    left: clamp(1rem, 3vw, 3.5rem);
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: clamp(10.75rem, 15vw, 14.5rem);
    z-index: 5;
  }

  .featured-index ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .featured-index li + li {
    border-top: 1px solid rgba(245, 244, 239, 0.18);
  }

  .featured-index__link {
    align-items: baseline;
    color: rgba(245, 244, 239, 0.42);
    display: grid;
    gap: 0.8rem;
    grid-template-columns: 2rem 1fr auto;
    min-height: 3.2rem;
    padding: 0.82rem 0;
    text-decoration: none;
    transition:
      color var(--motion-fast) var(--ease-emphasis),
      padding-left var(--motion-fast) var(--ease-emphasis);
  }

  .featured-index__link span {
    font-family: var(--sans);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
  }

  .featured-index__link strong {
    font-family: var(--sans);
    font-size: clamp(0.82rem, 1vw, 1rem);
    font-weight: 500;
  }

  .featured-index__link em {
    font-size: 0.68rem;
    font-style: normal;
    opacity: 0.72;
  }

  .featured-index__link:is(:hover, :focus-visible, .is-active) {
